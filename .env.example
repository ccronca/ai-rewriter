# AI Rewriter Configuration

# EnMaaS API Key (required) - Red Hat's AI gateway
# Get your key via the Atlas onboarding flow (requires corporate VPN)
ENMAAS_KEY=your_enmaas_key_here

# EnMaaS gateway base URL (required with ENMAAS_KEY)
# Not published here; get it from your platform team
ENMAAS_BASE_URL=

# Gemini API Key (optional) - set to use Google Gemini instead of EnMaaS
# Get your API key from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_api_key_here

# Server Port (optional, defaults to 8787)
PORT=8787

# Enable auto-reload for development (optional, defaults to false)
# Set to true for local development to auto-restart on code changes
# Set to false or remove for production use
ENABLE_RELOAD=false
